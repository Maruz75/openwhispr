# All credentials stay on this server; never embed them in the iOS binary.
BISIK_ENVIRONMENT=production
BISIK_DATABASE_PATH=data/bisik.sqlite3
BISIK_BUNDLE_ID=com.yourcompany.bisik
BISIK_FREE_SECONDS=900
BISIK_PRO_SECONDS=18000
BISIK_SESSION_SECONDS=2592000
BISIK_CACHE_SECONDS=300
BISIK_LEASE_SECONDS=300
BISIK_MAX_AUDIO_BYTES=25165824
BISIK_MAX_RECORDING_SECONDS=600
BISIK_FFPROBE_PATH=ffprobe
# Docker: set /tmp (RAM tmpfs in compose). Local: leave empty.
BISIK_TEMP_DIRECTORY=

# OpenAI-compatible /audio/transcriptions endpoint; base includes /v1.
BISIK_STT_BASE_URL=https://api.openai.com/v1
BISIK_STT_API_KEY=
BISIK_STT_MODEL=whisper-1
# Empty cleanup model disables cleanup. Set all three to enable.
BISIK_CLEANUP_BASE_URL=https://api.openai.com/v1
BISIK_CLEANUP_API_KEY=
BISIK_CLEANUP_MODEL=

# Sign in with Apple key (separate from App Store In-App Purchase key).
BISIK_SIGNIN_TEAM_ID=
BISIK_SIGNIN_KEY_ID=
BISIK_SIGNIN_PRIVATE_KEY_PATH=secrets/AuthKey_SIGNIN.p8
# Generate ONCE, keep/backup securely. Changing this breaks account deletion
# until stored refresh tokens are re-encrypted or users sign in again.
BISIK_REFRESH_ENCRYPTION_KEY=

# App Store Server API / signed JWS certificate verifier.
# Only Production accepted when BISIK_ENVIRONMENT=production.
# Use development + Sandbox for Apple's sandbox on real devices/TestFlight.
# Xcode local StoreKit transactions deliberately cannot grant server entitlement.
BISIK_APPLE_ENVIRONMENT=Production
BISIK_APPLE_APP_ID=
BISIK_APPLE_ROOT_PATHS=secrets/AppleRootCA-G3.cer
BISIK_APPLE_KEY_ID=
BISIK_APPLE_ISSUER_ID=
BISIK_APPLE_PRIVATE_KEY_PATH=secrets/SubscriptionKey_IAP.p8
BISIK_PRODUCT_IDS=com.maruz75.bisik.pro.monthly,com.maruz75.bisik.pro.annual
# In Docker change all key/root paths above to /run/secrets/<filename>.
